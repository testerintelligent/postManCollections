              "raw": "{\n  \"empId\": \"TG-{{$randomInt}}\",\n  \"employeeName\": \"{{$randomFullName}}\",\n  \"course\": \"{{chosenCourse}}\",\n  \"startDate\": \"{{randomDate}}\",\n  \"endDate\": \"{{randomDate}}\",\n  \"status\": \"{{chosenRole}}\",\n  \"trainerName\": \"{{$randomFullName}}\",\n  \"trainingType\": \"{{chosenTrainingType}}\",\n  \"percentCompleted\": 100,\n  \"projectName\": \"{{chosenProject}}\"\n}",
